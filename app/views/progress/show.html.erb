<% content_for :title, "Votre progression — RailsQuest" %>
<% total_exercises = @parts.flat_map(&:exercises) %>
<% total_completed = total_exercises.count { |ex| @completed_keys.include?(ex.key) } %>

<div class="page">
  <h1>Votre progression</h1>

  <p class="progress-total">
    Total : <span class="progress-count"><%= total_completed %> / <%= total_exercises.size %></span>
  </p>

  <div class="progress-layout">
    <ul class="progress-list">
      <% @parts.each do |part| %>
        <% part_completed = part.exercises.count { |ex| @completed_keys.include?(ex.key) } %>
        <li>
          <span>Partie <%= part.number %> — <%= part.title %></span>
          <span><%= part_completed %> / <%= part.exercises.size %></span>
        </li>
      <% end %>
    </ul>

    <% if @next_exercise %>
      <div class="progress-next">
        <p class="progress-next__label">Reprendre</p>
        <p class="progress-next__title"><%= @next_exercise[:exercise].title %></p>
        <p class="progress-next__meta">
          Partie <%= @next_exercise[:part].number %> — <%= @next_exercise[:chapter].title %>
        </p>
        <%= link_to "Continuer",
              part_chapter_path(@next_exercise[:part].slug, @next_exercise[:chapter].slug),
              class: "button-plain" %>
      </div>
    <% else %>
      <div class="progress-next">
        <p class="progress-next__label">Reprendre</p>
        <p class="progress-next__title">Tous les exercices écrits sont faits.</p>
      </div>
    <% end %>
  </div>

  <%= link_to root_path, class: "back-link" do %>
    <%= back_arrow %> Retour au sommaire
  <% end %>
</div>
