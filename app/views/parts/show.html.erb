<% content_for :title, "Partie #{@part.number} — #{@part.title} — RailsQuest" %>
<% accent = part_accent(@part.number) %>

<div class="page">
  <div class="issue-header" style="--part-accent: <%= accent %>">
    <span class="issue-header__number"><%= @part.number %></span>
    <div class="issue-header__text">
      <h1 class="issue-header__title"><%= @part.title %></h1>
      <% if @part.written? %>
        <p class="issue-header__meta">
          <%= pluralize(@part.chapters.size, "chapitre") %> · <%= pluralize(@part.exercises.size, "exercice") %>
        </p>
      <% end %>
    </div>
    <span class="issue-header__mark"><%= rail_mark(color: accent, size: 44) %></span>
  </div>

  <% if @part.written? && @part.exercises.any? %>
    <div class="issue-body">
      <%= render "parts/chapter_list", part: @part %>

      <div class="issue-exercises">
        <p class="issue-exercises__label">Exercices de cette partie</p>
        <ul class="issue-exercises__list">
          <% @part.chapters.each do |chapter| %>
            <% chapter.exercises.each do |exercise| %>
              <li>
                <span class="issue-exercises__key"><%= exercise.key %></span>
                <%= link_to exercise.title, part_chapter_path(@part.slug, chapter.slug) %>
              </li>
            <% end %>
          <% end %>
        </ul>
      </div>
    </div>
  <% elsif @part.written? %>
    <%= render "parts/chapter_list", part: @part %>
  <% else %>
    <p class="pending-note">Cette partie est à venir.</p>
  <% end %>

  <%= link_to root_path, class: "back-link" do %>
    <%= back_arrow %> Retour au sommaire
  <% end %>
</div>
